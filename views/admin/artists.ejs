<%- include('../partials/header') %>

<h1>Artists</h1>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Artist ID</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% artists.forEach(artist => { %>
      <tr>
        <td><strong><%= artist.name %></strong></td>
        <td><%= artist.email || "-" %></td>
        <td><%= artist.artistId || "-" %></td>
        <td>
          <a href="/admin/artist/<%= artist._id %>">View</a>
          <a href="/admin/artist/<%= artist._id %>/edit">Edit</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>